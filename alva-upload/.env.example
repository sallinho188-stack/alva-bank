# Authentication is OFF by default so the app can run standalone. Set to true only after configuring Better Auth + a real database.
VITE_AUTH_ENABLED=false

# Optional production PostgreSQL connection. Leave unset to use local PGlite.
DATABASE_URL=

# Required for production authentication.
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Optional OAuth providers.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Optional AI integration.
XAI_API_KEY=
